{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "CMake Configure XP Win32",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--preset",
				"xp-release"
			],
			"group": "build"
		},
		{
			"label": "CMake Rebuild Release",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build_xp_win32",
				"--config",
				"Release",
				"--clean-first"
			],
			"group": "build"
		},
		{
			"label": "CMake Build Release",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build_xp_win32",
				"--config",
				"Release"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}