{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "CMake Configure Win32",
			"type": "shell",
			"command": "cmake",
			"args": [
				"-S",
				".",
				"-B",
				"build",
				"-A",
				"Win32"
			],
			"group": "build"
		},
		{
			"label": "CMake Rebuild Release",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build",
				"--config",
				"Release",
				"--clean-first"
			],
			"group": "build"
		},
		{
			"label": "CMake Rebuild Debug",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build",
				"--config",
				"Debug",
				"--clean-first"
			],
			"group": "build"
		}
	]
}