{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "CMake Configure XP Win32",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--preset",
				"xp-release"
			],
			"group": "build"
		},
		{
			"label": "CMake Rebuild Release",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build_xp_win32",
				"--config",
				"Release",
				"--clean-first"
			],
			"group": "build"
		},
		{
			"label": "CMake Build Release",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build_xp_win32",
				"--config",
				"Release"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "CMake Configure XP Trace Win32",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--preset",
				"xp-trace"
			],
			"group": "build"
		},
		{
			"label": "CMake Build Trace DLL",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"--preset",
				"build-xp-trace",
				"--target",
				"efz_netplay_mod"
			],
			"dependsOn": "CMake Configure XP Trace Win32",
			"group": "build"
		},
		{
			"label": "Debug DLL Configure",
			"type": "shell",
			"command": "cmake",
			"args": [
				"-S",
				"stock_debug_probe",
				"-B",
				"build_probe",
				"-A",
				"Win32",
				"-T",
				"v141_xp"
			],
			"group": "build"
		},
		{
			"label": "Debug DLL Build",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build_probe",
				"--config",
				"Release"
			],
			"group": "build"
		}
	]
}
